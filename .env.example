# Sandwalkers — налаштування сервера (server/index.mjs читає .env). Snotax console заповнює значення сам:
#   snotax-console env      — копіює цей файл у .env і вписує з'єднання з Postgres і Mailpit
#   snotax-console db create dune
APP_URL=https://dune.test

# база: Postgres (без DB_HOST — запасна SQLite у server/data/app.db)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dune
DB_USERNAME=postgres
DB_PASSWORD=

# пошта для кодів входу: Mailpit у розробці (скринька — http://127.0.0.1:8025/proxy/mailpit/)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@dune.test
MAIL_FROM_NAME=Sandwalkers

# сховище файлів (зображення): RustFS із Snotax console (S3); без S3_ENDPOINT — тека server/data/files
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=sandwalkers
S3_KEY=storageadmin
S3_SECRET=storageadmin
S3_REGION=us-east-1
