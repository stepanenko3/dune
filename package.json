{
  "name": "sandwalkers",
  "private": true,
  "version": "2.0.0",
  "description": "Sandwalkers — бази, план розвитку і мапа ресурсів для Dune: Awakening",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"node --watch-path=server/lib --watch-path=server/routes --watch-path=server/admin --watch-path=src/engine/basegen --watch-path=locales --watch-path=server/app.mjs --watch-path=server/index.mjs server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs --serve-dist",
    "map:sync": "node scripts/map-sync.mjs",
    "map:prefetch": "node scripts/map-prefetch.mjs",
    "check": "node tools/check-model.js && node tools/check-model.js src/engine/model-dd.js",
    "test": "vitest run",
    "orni:atreides": "node scripts/orni-atreides.mjs",
    "orni:lite": "node scripts/orni-lite.mjs",
    "drone:buster": "node scripts/buster-drone.mjs",
    "bases:export": "node scripts/bases-export.mjs",
    "ui:sync": "node scripts/sync-snotax-ui.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:merge": "node scripts/i18n-merge.mjs",
    "gdx": "node tools/game-extractor/bin/gdx.mjs",
    "seed:demo": "vite-node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@snotax/ui": "file:vendor/snotax-ui",
    "cbor-x": "^1.6.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "leaflet": "1.9",
    "lit": "^3.3.3",
    "lucide-react": "^1.57.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "three": "^0.128.0",
    "web-push": "^3.6.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.128.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.2.2",
    "meshoptimizer": "^1.3.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
