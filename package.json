{
  "name": "sandwalkers",
  "private": true,
  "version": "2.0.0",
  "description": "Sandwalkers — бази, план розвитку і мапа ресурсів для Dune: Awakening",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"node --watch-path=server/lib --watch-path=server/routes --watch-path=server/app.mjs --watch-path=server/index.mjs server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs --serve-dist",
    "map:sync": "node scripts/map-sync.mjs",
    "map:prefetch": "node scripts/map-prefetch.mjs",
    "check": "node tools/check-model.js && node tools/check-model.js src/engine/model-dd.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "cbor-x": "^1.6.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "leaflet": "1.9",
    "lucide-react": "^1.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "three": "^0.128.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.128.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
